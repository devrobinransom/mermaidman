# Copy to .env.local and fill in only what you need.

# AI co-authoring (Summarize / Expand / Diagram in the node inspector).
# The provider key stays server-side in /api/ai.
ANTHROPIC_API_KEY=

# AI access fails closed by default. For a small trusted/same-origin deployment,
# explicitly opt in to browser AI calls. Requests are then throttled per client.
# Do not enable this blindly on an internet-facing high-traffic deployment.
MERMAIDMAN_AI_ALLOW_PUBLIC=false
MERMAIDMAN_AI_RATE_LIMIT_PER_MINUTE=8

# Alternative access policy for API clients/reverse-proxy integrations.
# When set, /api/ai requires this value in the x-mermaidman-ai-token header.
# The current browser UI does not persist or expose this secret.
MERMAIDMAN_AI_ACCESS_TOKEN=

# Giphy GIF search (Media tab in the Insert drawer).
# Get a free key at https://developers.giphy.com/ — the key stays server-side
# (used only by the /api/giphy route). Without it, GIF search is disabled but
# pasting an image/GIF URL still works.
GIPHY_API_KEY=
