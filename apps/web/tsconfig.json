{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "comment-exclude": "The radical-ai-studio-kit is a vendored demo kit with broken/unused files (missing deps like motion/react, @tabler/icons-react). It is excluded as a type-check ROOT; the handful of components the app actually imports (Button, Card, Tabs, etc.) are still type-checked via the import graph.",
  "exclude": [
    "node_modules",
    "src/components/radical-ai-studio-kit"
  ]
}
